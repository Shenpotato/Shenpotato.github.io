# 飞书应用配置
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# 飞书文档空间配置（可选）
# 如果不配置，会自动扫描根文件夹
FEISHU_ROOT_FOLDER_TOKEN=optional_folder_token_here

# 图片路径配置（可选）
# 不设置则自动检测环境：本地使用相对路径，CI/服务器使用绝对路径
# USE_RELATIVE_IMAGE_PATH=true  # 强制使用相对路径（本地预览）
# USE_RELATIVE_IMAGE_PATH=false # 强制使用绝对路径（Jekyll网站）

# 同步配置
SYNC_INTERVAL_MINUTES=60
POSTS_DIR=../_posts
IMG_DIR=../img/in-post
